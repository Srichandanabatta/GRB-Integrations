<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LeadSource_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Closed - Converted&quot;) = FALSE, 
    ISPICKVAL(LeadSource, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>If you select other than closed then Lead source is a mandatory enter</errorMessage>
</ValidationRule>
